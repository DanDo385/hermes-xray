# Server-side portfolio inference (never expose to the browser)
GEMINI_API_KEY=
# Optional aliases also accepted:
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Cheap free-tier default — override if your AI Studio project uses another id
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional defaults for BYOK visitors
# OPENAI_MODEL=gpt-4.1-mini
# XAI_MODEL=grok-2-latest
