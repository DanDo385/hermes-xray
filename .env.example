# Server-side portfolio inference (never expose to the browser)
GEMINI_API_KEY=
# Optional aliases also accepted:
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Cheap free-tier default - override if your AI Studio project uses another id
# (Hermes CLI may show gemini-3.1-flash-lite; API id is usually the -preview suffix.)
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Optional defaults for BYOK visitors (platform + key chosen in the UI)
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# XAI_MODEL=grok-2-latest
# OPENROUTER_MODEL=openai/gpt-4o-mini
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
# OPENROUTER_SITE_URL=https://your-deployed-site.example
